{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "not-yet-website",
  "compatibility_date": "2026-09-05",
  "main": "src/index.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
    // Do NOT set "html_handling": "none" -- avclock-website tried this
    // and it took the whole site down (confirmed live: "/" started
    // 404ing, only "/index.html" still served). "none" disables ALL
    // automatic URL resolution, not just the .html-extension redirect
    // it was meant to stop. Leave this on Cloudflare's default
    // ("auto-trailing-slash").
  },
  // The analytics store. This has to live here, not only in the
  // dashboard: every deploy (each push to main) sets the Worker's
  // bindings to exactly what this file declares, so a binding added
  // by hand under Settings -> Bindings was silently dropped by the
  // next deploy, and analytics.html went back to "Not connected yet."
  // No "id" on purpose: Wrangler keeps using the namespace already
  // bound as ANALYTICS_KV if there is one, and otherwise creates one
  // (named "not-yet-website-analytics-kv") on the next deploy.
  "kv_namespaces": [
    { "binding": "ANALYTICS_KV" }
  ]
}
